# Copy to terraform.tfvars and adjust. Values here are examples.

aws_region   = "us-east-1"
project_name = "uno-infra-misp"
environment  = "prod"

# --- Existing network (this module does NOT create a VPC) ---
vpc_id    = "vpc-0123456789abcdef0"
subnet_id = "subnet-0123456789abcdef0"

# Keep false for a private subnet fronted by an ALB or accessed via SSM.
assign_public_ip = false

# --- Sizing ---
instance_type       = "t3.large" # 8 GB / 2 vCPU - low-load / single-feed (ANCI). Use t3.xlarge for heavy feeds.
root_volume_size_gb = 50
data_volume_size_gb = 150 # root 50 + data 150 = 200 GB (ANCI recommended). set 0 to keep all on root

# --- Access ---
# Prefer SSM (always on via IAM). Only enable SSH if you really need it.
enable_ssh        = false
ssh_ingress_cidrs = [] # e.g. ["10.0.0.0/8"] when enable_ssh = true
key_name          = ""

# --- Application ingress ---
# Two modes:
#   A) Direct (simple/testing): open 443 to specific CIDRs, no ALB.
#   B) ALB + ACM (production): set enable_alb=true below; then the instance SG
#      accepts 443 ONLY from the ALB SG and allowed_https_cidrs can be [].
allowed_https_cidrs = ["10.0.0.0/8"]
enable_http         = false

# --- ALB + TLS (production pattern) ---
# enable_alb          = true
# acm_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# alb_subnet_ids      = ["subnet-aaaa1111", "subnet-bbbb2222"] # >=2 AZs, public for internet-facing
# alb_internal        = false
# alb_ingress_cidrs   = ["10.0.0.0/8"]   # who can reach the ALB on 443
# Alternatively, reference an EXISTING ALB SG instead of creating the ALB here:
# alb_security_group_id = "sg-0123456789abcdef0"

# --- IAM scoping (PRODUCTION: tighten these; defaults are ["*"] for testing) ---
# ecr_repository_arns = [
#   "arn:aws:ecr:us-east-1:111122223333:repository/uno-infra-misp/misp-core",
#   "arn:aws:ecr:us-east-1:111122223333:repository/uno-infra-misp/misp-modules",
# ]
# secrets_manager_arns = [
#   "arn:aws:secretsmanager:us-east-1:111122223333:secret:prod/misp/*",
# ]

# --- Bootstrap ---
repo_url    = "https://github.com/unoafp/uno-infra-misp.git"
repo_branch = "main"
