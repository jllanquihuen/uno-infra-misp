# Terraform working files - never commit
.terraform/
.terraform.tfstate.lock.info

# State (should live in a remote backend, never in git)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable files (may contain account-specific values). Commit only the .example
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / plan output
.terraformrc
terraform.rc
*.tfplan
tfplan
tfplan.*
