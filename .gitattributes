# Ensure shell scripts, Dockerfiles and container config files always use LF.
# These files run inside Linux containers; CRLF line endings break the shell
# (e.g. "apt-get update\r" and heredocs) and nginx/supervisor parsing.

*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
Makefile        text eol=lf

# nginx/supervisor config files without extensions
core/files/etc/nginx/includes/misp              text eol=lf
core/files/etc/nginx/sites-available/misp443    text eol=lf
core/files/etc/nginx/sites-available/misp80     text eol=lf
core/files/etc/nginx/sites-available/php-fpm-status text eol=lf

# Kubernetes variants of supervisor/worker configs
core/files/etc/supervisor/conf.d/*.kubernetes   text eol=lf
